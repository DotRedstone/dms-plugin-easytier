#!/usr/bin/env bash
set -euo pipefail

# [Configuration]
EASYTIER_CLI_BIN="${EASYTIER_CLI_BIN:-easytier-cli}"
EASYTIER_CORE_BIN="${EASYTIER_CORE_BIN:-easytier-core}"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
SYSTEMD_RUN_BIN="${SYSTEMD_RUN_BIN:-systemd-run}"
PKEXEC_BIN="${PKEXEC_BIN:-pkexec}"
SUDO_BIN="${SUDO_BIN:-sudo}"

CONFIG_DIR="${EASYTIER_DMS_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/easytier-dms}"
PROFILES_FILE="$CONFIG_DIR/profiles.json"
RUNTIME_DIR="${EASYTIER_DMS_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp/easytier-dms-$(id -u)}/easytier-dms}"
MANAGED_ENV_FILE="$RUNTIME_DIR/managed.env"
MANAGED_TOML_FILE="$RUNTIME_DIR/managed.toml"
ROOT_RUNTIME_DIR="/run/easytier-dms"
MANAGED_UNIT="dms-easytier-managed.service"

DEFAULT_RPC="127.0.0.1:15888"
DEFAULT_UNIT="easytier.service"
DEFAULT_SCOPE="system"

SELF_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"

# [Error Helpers]
json_error() {
    local msg="${1:-Unknown error}"
    jq -cn --arg error "$msg" '{ok: false, error: $error}'
}

ensure_private_dir() {
    local dir="$1"
    mkdir -p "$dir"
    chmod 700 "$dir" 2>/dev/null || true
}

# [Validation]
validate_rpc() {
    local rpc="$1"
    if [[ -z "$rpc" || "$rpc" == -* || "$rpc" == *[!a-zA-Z0-9._:\[\]-]* ]]; then
        return 1
    fi
    return 0
}

normalize_unit() {
    local unit="$1"
    if [[ -z "$unit" ]]; then
        unit="$DEFAULT_UNIT"
    elif [[ "$unit" != *.* ]]; then
        unit="${unit}.service"
    fi
    if [[ "$unit" == -* || "$unit" == *[!a-zA-Z0-9@_.:-]* ]]; then
        return 1
    fi
    printf '%s\n' "$unit"
}

validate_scope() {
    local scope="$1"
    [[ "$scope" == "system" || "$scope" == "user" ]]
}

validate_connector_url() {
    local url="$1"
    if [[ -z "$url" || "$url" == -* || "$url" == *[[:space:]]* || "$url" != *://?* ]]; then
        return 1
    fi
    local scheme="${url%%://*}"
    if [[ -z "$scheme" || "$scheme" == *[!a-zA-Z0-9+.-]* ]]; then
        return 1
    fi
    return 0
}

validate_socket_addr() {
    local addr="$1"
    if [[ -z "$addr" || "$addr" == -* || "$addr" == *[[:space:]]* || "$addr" != *:* ]]; then
        return 1
    fi
    local port="${addr##*:}"
    if [[ -z "$port" || "$port" == *[!0-9]* ]]; then
        return 1
    fi
    return 0
}

escape_env_value() {
    local val="$1"
    val="${val//\\/\\\\}"
    val="${val//\"/\\\"}"
    printf '%s' "$val"
}

# [Profile Schema & TOML Rendering]
normalize_profile_json() {
    local raw_json="$1"
    local gen_id="${2:-prof-default}"
    printf '%s' "$raw_json" | jq -ce --arg genId "$gen_id" '
        def trim_str: tostring | gsub("^\\s+|\\s+$"; "");
        def clean_arr: [ (. // [])[] | trim_str | select(length > 0) ] | unique;
        def bool_or($v; $d): if ($v == true or $v == false) then $v else $d end;
        def int_range($v; $min; $max; $d):
            (($v // $d) | tonumber? // $d | floor) as $n
            | if ($n >= $min and $n <= $max) then $n else $d end;
        def digits_only: trim_str | if test("^[0-9]+$") then . else "" end;

        (.flags // {}) as $rf
        | bool_or($rf.noTun; (.noTun == true)) as $noTunVal
        | {
            id: ((.id // "" | trim_str) | if length > 0 then . else $genId end),
            name: (.name // "" | trim_str),
            configMode: (
                (.configMode // "manual" | trim_str) as $m
                | if ($m == "uri" or $m == "standalone") then $m else "manual" end
            ),
            configServer: (.configServer // "" | trim_str),
            machineId: (.machineId // "" | trim_str),
            instanceName: (.instanceName // "" | trim_str),
            hostname: (.hostname // "" | trim_str),
            networkName: (.networkName // "" | trim_str),
            networkSecret: (.networkSecret // "" | tostring),
            dhcp: (.dhcp != false),
            ipv4: (.ipv4 // "" | trim_str),
            ipv6: (.ipv6 // "" | trim_str),
            ipv6PublicProvider: (.ipv6PublicProvider == true),
            ipv6PublicAuto: (.ipv6PublicAuto == true),
            peers: (.peers | clean_arr),
            listeners: (.listeners | clean_arr),
            mappedListeners: (.mappedListeners | clean_arr),
            noListener: (.noListener == true),
            proxyCidrs: (.proxyCidrs | clean_arr),
            manualRoutes: (.manualRoutes | clean_arr),
            exitNodes: (.exitNodes | clean_arr),
            socks5: (.socks5 // "" | trim_str),
            vpnPortalEnabled: (.vpnPortalEnabled == true),
            vpnClientCidr: ((.vpnClientCidr // "10.144.145.0/24" | trim_str) | if length > 0 then . else "10.144.145.0/24" end),
            vpnWireguardListen: ((.vpnWireguardListen // "0.0.0.0:11011" | trim_str) | if length > 0 then . else "0.0.0.0:11011" end),
            portForwards: [
                (.portForwards // [])[]
                | select(type == "object")
                | {
                    proto: (if ((.proto // "tcp" | trim_str | ascii_downcase) == "udp") then "udp" else "tcp" end),
                    bindAddr: ((.bindAddr // .bind_addr // "") | trim_str),
                    dstAddr: ((.dstAddr // .dst_addr // "") | trim_str)
                }
                | select((.bindAddr | length > 0) and (.dstAddr | length > 0))
            ],
            flags: {
                defaultProtocol: (
                    ($rf.defaultProtocol // "tcp" | trim_str | ascii_downcase) as $p
                    | if ($p == "udp" or $p == "ws" or $p == "wss" or $p == "quic" or $p == "wg") then $p else "tcp" end
                ),
                encryptionAlgorithm: (
                    ($rf.encryptionAlgorithm // "aes-gcm" | trim_str | ascii_downcase) as $a
                    | if ($a == "aes-256-gcm" or $a == "chacha20" or $a == "xor") then $a else "aes-gcm" end
                ),
                compression: (if ($rf.compression // "none" | trim_str | ascii_downcase) == "zstd" then "zstd" else "none" end),
                mtu: int_range($rf.mtu; 576; 65535; 1380),
                multiThread: bool_or($rf.multiThread; true),
                multiThreadCount: int_range($rf.multiThreadCount; 2; 128; 2),
                devName: ($rf.devName // "" | trim_str),
                relayNetworkWhitelist: (if ($rf | has("relayNetworkWhitelist")) then ($rf.relayNetworkWhitelist | trim_str) else "*" end),
                tldDnsZone: (($rf.tldDnsZone // "et.net." | trim_str) | if length > 0 then . else "et.net." end),
                foreignRelayBpsLimit: ($rf.foreignRelayBpsLimit // "" | digits_only),
                instanceRecvBpsLimit: ($rf.instanceRecvBpsLimit // "" | digits_only),
                enableEncryption: bool_or($rf.enableEncryption; true),
                enableIpv6: bool_or($rf.enableIpv6; true),
                latencyFirst: bool_or($rf.latencyFirst; false),
                enableExitNode: bool_or($rf.enableExitNode; false),
                noTun: $noTunVal,
                useSmoltcp: bool_or($rf.useSmoltcp; false),
                bindDevice: bool_or($rf.bindDevice; true),
                proxyForwardBySystem: bool_or($rf.proxyForwardBySystem; false),
                enableP2p: bool_or($rf.enableP2p; true),
                p2pOnly: bool_or($rf.p2pOnly; false),
                lazyP2p: bool_or($rf.lazyP2p; false),
                needP2p: bool_or($rf.needP2p; false),
                disableTcpHolePunching: bool_or($rf.disableTcpHolePunching; false),
                disableUdpHolePunching: bool_or($rf.disableUdpHolePunching; false),
                disableSymHolePunching: bool_or($rf.disableSymHolePunching; false),
                enableUpnp: bool_or($rf.enableUpnp; true),
                enableKcpProxy: bool_or($rf.enableKcpProxy; false),
                disableKcpInput: bool_or($rf.disableKcpInput; false),
                enableQuicProxy: bool_or($rf.enableQuicProxy; false),
                disableQuicInput: bool_or($rf.disableQuicInput; false),
                relayAllPeerRpc: bool_or($rf.relayAllPeerRpc; false),
                disableRelayData: bool_or($rf.disableRelayData; false),
                disableRelayKcp: bool_or($rf.disableRelayKcp; false),
                disableRelayQuic: bool_or($rf.disableRelayQuic; false),
                enableRelayForeignKcp: bool_or($rf.enableRelayForeignKcp; false),
                enableRelayForeignQuic: bool_or($rf.enableRelayForeignQuic; false),
                acceptDns: bool_or($rf.acceptDns; false),
                privateMode: bool_or($rf.privateMode; false),
                enableUdpBroadcastRelay: bool_or($rf.enableUdpBroadcastRelay; false)
            },
            noTun: $noTunVal,
            consoleLogLevel: (
                (.consoleLogLevel // "warn" | trim_str | ascii_downcase) as $l
                | if ($l == "off" or $l == "error" or $l == "warn" or $l == "info" or $l == "debug" or $l == "trace") then $l else "warn" end
            ),
            fileLogLevel: (
                (.fileLogLevel // "" | trim_str | ascii_downcase) as $l
                | if ($l == "error" or $l == "warn" or $l == "info" or $l == "debug" or $l == "trace") then $l else "" end
            ),
            fileLogDir: (.fileLogDir // "" | trim_str),
            fileLogName: (.fileLogName // "" | trim_str)
        }
    '
}

validate_normalized_profile() {
    local norm="$1"
    local prof_id prof_name cfg_mode cfg_srv net_name net_secret
    prof_id="$(jq -r '.id' <<<"$norm")"
    prof_name="$(jq -r '.name' <<<"$norm")"
    cfg_mode="$(jq -r '.configMode' <<<"$norm")"
    cfg_srv="$(jq -r '.configServer' <<<"$norm")"
    net_name="$(jq -r '.networkName' <<<"$norm")"
    net_secret="$(jq -r '.networkSecret' <<<"$norm")"

    if [[ "$prof_id" == *[!a-zA-Z0-9_-]* ]]; then
        printf 'Invalid profile ID\n' >&2
        return 1
    fi
    if [[ -z "$prof_name" ]]; then
        printf 'Profile name is required\n' >&2
        return 1
    fi
    if [[ "$cfg_srv" == *$'\n'* || "$cfg_srv" == *$'\r'* || "$net_secret" == *$'\n'* || "$net_secret" == *$'\r'* ]]; then
        printf 'Credentials must not contain newlines\n' >&2
        return 1
    fi
    if [[ "$cfg_mode" == "uri" ]]; then
        if [[ -z "$cfg_srv" ]]; then
            printf 'Config server URI is required\n' >&2
            return 1
        fi
        return 0
    fi

    if [[ -z "$net_name" || "$net_name" == -* ]]; then
        printf 'Valid network name is required\n' >&2
        return 1
    fi

    local item
    while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        if ! validate_connector_url "$item"; then
            printf 'Invalid peer URL: %s\n' "$item" >&2
            return 1
        fi
    done < <(jq -r '.peers[]' <<<"$norm")

    while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        if ! validate_connector_url "$item"; then
            printf 'Invalid listener URL: %s\n' "$item" >&2
            return 1
        fi
    done < <(jq -r '.listeners[], .mappedListeners[]' <<<"$norm")

    while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        if [[ "$item" == -* || "$item" == *[!0-9./a-fA-F:\>-]* ]]; then
            printf 'Invalid CIDR or route: %s\n' "$item" >&2
            return 1
        fi
    done < <(jq -r '.proxyCidrs[], .manualRoutes[], .exitNodes[]' <<<"$norm")

    local bind_a dst_a
    while IFS=$'\t' read -r bind_a dst_a; do
        [[ -z "$bind_a" && -z "$dst_a" ]] && continue
        if ! validate_socket_addr "$bind_a" || ! validate_socket_addr "$dst_a"; then
            printf 'Invalid port forward address: %s -> %s\n' "$bind_a" "$dst_a" >&2
            return 1
        fi
    done < <(jq -r '.portForwards[] | "\(.bindAddr)\t\(.dstAddr)"' <<<"$norm")

    if [[ "$(jq -r '.vpnPortalEnabled' <<<"$norm")" == "true" ]]; then
        local v_cidr v_listen
        v_cidr="$(jq -r '.vpnClientCidr' <<<"$norm")"
        v_listen="$(jq -r '.vpnWireguardListen' <<<"$norm")"
        if [[ -z "$v_cidr" || "$v_cidr" != */* ]] || ! validate_socket_addr "$v_listen"; then
            printf 'Invalid WireGuard VPN Portal settings\n' >&2
            return 1
        fi
    fi
    return 0
}

render_profile_toml() {
    local norm="$1"
    printf '%s' "$norm" | jq -r '
        def socks_norm($s):
            if ($s | length) == 0 then ""
            elif ($s | startswith("socks5://")) then $s
            elif ($s | test("^[0-9]+$")) then ("socks5://0.0.0.0:" + $s)
            elif ($s | contains("://") | not) then ("socks5://" + $s)
            else $s end;

        [
            (if (.instanceName | length) > 0 and .instanceName != "default" then "instance_name = \(.instanceName | @json)" else empty end),
            (if (.hostname | length) > 0 then "hostname = \(.hostname | @json)" else empty end),
            (if .dhcp then "dhcp = true" elif (.ipv4 | length) > 0 then "ipv4 = \(.ipv4 | @json)" else empty end),
            (if (.ipv6 | length) > 0 then "ipv6 = \(.ipv6 | @json)" else empty end),
            (if .ipv6PublicProvider then "ipv6_public_addr_provider = true" else empty end),
            (if .ipv6PublicAuto then "ipv6_public_addr_auto = true" else empty end),
            (if .noListener then "listeners = []" elif (.listeners | length) > 0 then "listeners = \(.listeners | @json)" else empty end),
            (if (.mappedListeners | length) > 0 then "mapped_listeners = \(.mappedListeners | @json)" else empty end),
            (if (.exitNodes | length) > 0 then "exit_nodes = \(.exitNodes | @json)" else empty end),
            (if (.manualRoutes | length) > 0 then "routes = \(.manualRoutes | @json)" else empty end),
            (socks_norm(.socks5) as $sk | if ($sk | length) > 0 then "socks5_proxy = \($sk | @json)" else empty end),
            "",
            "[network_identity]",
            "network_name = \((if (.networkName | length) > 0 then .networkName else "default" end) | @json)",
            (if (.networkSecret | length) > 0 then "network_secret = \(.networkSecret | @json)" else empty end),
            (
                if .configMode == "manual" then
                    (.peers[] | "", "[[peer]]", "uri = \(. | @json)")
                else empty end
            ),
            (.proxyCidrs[] | "", "[[proxy_network]]", "cidr = \(. | @json)"),
            (
                if .vpnPortalEnabled then
                    "", "[vpn_portal_config]",
                    "client_cidr = \(.vpnClientCidr | @json)",
                    "wireguard_listen = \(.vpnWireguardListen | @json)"
                else empty end
            ),
            (
                .portForwards[] |
                "", "[[port_forward]]",
                "bind_addr = \(.bindAddr | @json)",
                "dst_addr = \(.dstAddr | @json)",
                "proto = \(.proto | @json)"
            ),
            "",
            "[flags]",
            "default_protocol = \(.flags.defaultProtocol | @json)",
            (if (.flags.devName | length) > 0 then "dev_name = \(.flags.devName | @json)" else empty end),
            "enable_encryption = \(.flags.enableEncryption)",
            "encryption_algorithm = \(.flags.encryptionAlgorithm | @json)",
            "enable_ipv6 = \(.flags.enableIpv6)",
            "mtu = \(.flags.mtu)",
            "latency_first = \(.flags.latencyFirst)",
            "enable_exit_node = \(.flags.enableExitNode)",
            "proxy_forward_by_system = \(.flags.proxyForwardBySystem)",
            "no_tun = \(.flags.noTun)",
            "use_smoltcp = \(.flags.useSmoltcp)",
            "relay_network_whitelist = \(.flags.relayNetworkWhitelist | @json)",
            "disable_p2p = \(.flags.enableP2p | not)",
            "p2p_only = \(.flags.p2pOnly)",
            "lazy_p2p = \(.flags.lazyP2p)",
            "need_p2p = \(.flags.needP2p)",
            "relay_all_peer_rpc = \(.flags.relayAllPeerRpc)",
            "disable_tcp_hole_punching = \(.flags.disableTcpHolePunching)",
            "disable_udp_hole_punching = \(.flags.disableUdpHolePunching)",
            "disable_sym_hole_punching = \(.flags.disableSymHolePunching)",
            "disable_upnp = \(.flags.enableUpnp | not)",
            "multi_thread = \(.flags.multiThread)",
            (if .flags.multiThreadCount > 2 then "multi_thread_count = \(.flags.multiThreadCount)" else empty end),
            (if .flags.compression == "zstd" then "data_compress_algo = 2" else empty end),
            "bind_device = \(.flags.bindDevice)",
            "enable_kcp_proxy = \(.flags.enableKcpProxy)",
            "disable_kcp_input = \(.flags.disableKcpInput)",
            "enable_quic_proxy = \(.flags.enableQuicProxy)",
            "disable_quic_input = \(.flags.disableQuicInput)",
            "disable_relay_data = \(.flags.disableRelayData)",
            "disable_relay_kcp = \(.flags.disableRelayKcp)",
            "disable_relay_quic = \(.flags.disableRelayQuic)",
            "enable_relay_foreign_network_kcp = \(.flags.enableRelayForeignKcp)",
            "enable_relay_foreign_network_quic = \(.flags.enableRelayForeignQuic)",
            "accept_dns = \(.flags.acceptDns)",
            "tld_dns_zone = \(.flags.tldDnsZone | @json)",
            "private_mode = \(.flags.privateMode)",
            "enable_udp_broadcast_relay = \(.flags.enableUdpBroadcastRelay)",
            (if (.flags.foreignRelayBpsLimit | length) > 0 then "foreign_relay_bps_limit = \(.flags.foreignRelayBpsLimit)" else empty end),
            (if (.flags.instanceRecvBpsLimit | length) > 0 then "instance_recv_bps_limit = \(.flags.instanceRecvBpsLimit)" else empty end),
            (
                if (.consoleLogLevel | length) > 0 and .consoleLogLevel != "warn" then
                    "", "[console_logger]", "level = \(.consoleLogLevel | @json)"
                else empty end
            ),
            (
                if (.fileLogLevel | length) > 0 then
                    "", "[file_logger]",
                    "level = \(.fileLogLevel | @json)",
                    (if (.fileLogDir | length) > 0 then "dir = \(.fileLogDir | @json)" else empty end),
                    (if (.fileLogName | length) > 0 then "file = \(.fileLogName | @json)" else empty end)
                else empty end
            )
        ] | join("\n")
    '
}

# [Profile Storage]
read_profiles_store() {
    if [[ ! -f "$PROFILES_FILE" ]]; then
        printf '{"activeProfileId":"","profiles":[]}\n'
        return 0
    fi
    jq -c '{
        activeProfileId: (.activeProfileId // "" | tostring),
        profiles: (if (.profiles | type) == "array" then .profiles else [] end)
    }' "$PROFILES_FILE" 2>/dev/null || printf '{"activeProfileId":"","profiles":[]}\n'
}

write_profiles_store() {
    local content="$1"
    ensure_private_dir "$CONFIG_DIR"
    local tmp_file="${PROFILES_FILE}.tmp.$$"
    (
        umask 077
        printf '%s\n' "$content" >"$tmp_file"
    )
    mv -f "$tmp_file" "$PROFILES_FILE"
}

sanitize_profiles_summary() {
    local store_json="$1"
    printf '%s' "$store_json" | jq -c '{
        activeProfileId: (.activeProfileId // ""),
        profiles: [
            (.profiles // [])[]
            | {
                id: (.id // ""),
                name: (.name // ""),
                configMode: (.configMode // "manual"),
                networkName: (.networkName // ""),
                dhcp: (.dhcp != false),
                ipv4: (.ipv4 // ""),
                peerCount: ((.peers // []) | length),
                listenerCount: ((.listeners // []) | length),
                proxyCount: ((.proxyCidrs // []) | length),
                portForwardCount: ((.portForwards // []) | length),
                vpnPortalEnabled: (.vpnPortalEnabled == true),
                noTun: (if (.flags | type) == "object" and (.flags | has("noTun")) then (.flags.noTun == true) else (.noTun == true) end)
            }
        ]
    }'
}

# [Systemd & Privileged Execution]
service_state() {
    local unit="$1"
    local scope="$2"
    if ! command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1; then
        printf 'unknown\n'
        return 0
    fi
    local state
    if [[ "$scope" == "user" ]]; then
        state="$("$SYSTEMCTL_BIN" --user is-active "$unit" 2>/dev/null || true)"
    else
        state="$("$SYSTEMCTL_BIN" is-active "$unit" 2>/dev/null || true)"
    fi
    state="${state%%$'\n'*}"
    printf '%s\n' "${state:-inactive}"
}

managed_unit_info() {
    local u_state s_state
    u_state="$(service_state "$MANAGED_UNIT" "user")"
    if [[ "$u_state" == "active" || "$u_state" == "activating" ]]; then
        printf '%s\tuser\n' "$u_state"
        return 0
    fi
    s_state="$(service_state "$MANAGED_UNIT" "system")"
    if [[ "$s_state" == "active" || "$s_state" == "activating" ]]; then
        printf '%s\tsystem\n' "$s_state"
        return 0
    fi
    if [[ "$u_state" == "failed" ]]; then
        printf 'failed\tuser\n'
    elif [[ "$s_state" == "failed" ]]; then
        printf 'failed\tsystem\n'
    else
        printf 'inactive\t\n'
    fi
}

run_as_root() {
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        "$@"
        return $?
    fi
    if command -v "$SUDO_BIN" >/dev/null 2>&1 && "$SUDO_BIN" -n true >/dev/null 2>&1; then
        "$SUDO_BIN" -n "$@"
        return $?
    fi
    if command -v "$PKEXEC_BIN" >/dev/null 2>&1; then
        "$PKEXEC_BIN" "$@"
        return $?
    fi
    printf 'pkexec or passwordless sudo is required\n' >&2
    return 1
}

run_service_action() {
    local action="$1"
    local unit="$2"
    local scope="$3"

    if ! command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1; then
        printf 'systemctl is not available\n' >&2
        return 1
    fi

    if [[ "$scope" == "user" ]]; then
        "$SYSTEMCTL_BIN" --user "$action" "$unit"
        return $?
    fi

    if "$SYSTEMCTL_BIN" --no-ask-password "$action" "$unit" 2>/dev/null; then
        return 0
    fi

    local systemctl_path
    systemctl_path="$(command -v "$SYSTEMCTL_BIN")"
    run_as_root "$systemctl_path" "$action" "$unit"
}

# [Managed Profile Runner]
start_managed_profile() {
    local req_id="$1"
    local rpc="$2"

    if ! command -v "$EASYTIER_CORE_BIN" >/dev/null 2>&1; then
        printf 'easytier-core is not installed\n' >&2
        return 1
    fi
    if ! command -v "$SYSTEMD_RUN_BIN" >/dev/null 2>&1; then
        printf 'systemd-run is not available\n' >&2
        return 1
    fi

    local store profile_id raw_prof norm
    store="$(read_profiles_store)"
    profile_id="$req_id"
    if [[ -z "$profile_id" ]]; then
        profile_id="$(jq -r '.activeProfileId // ""' <<<"$store")"
    fi
    if [[ -z "$profile_id" ]]; then
        profile_id="$(jq -r '.profiles[0].id // ""' <<<"$store")"
    fi
    if [[ -z "$profile_id" ]]; then
        printf 'No network profile configured\n' >&2
        return 1
    fi

    raw_prof="$(jq -ce --arg id "$profile_id" '(.profiles[] | select(.id == $id))' <<<"$store" 2>/dev/null || true)"
    if [[ -z "$raw_prof" ]]; then
        printf 'Profile not found: %s\n' "$profile_id" >&2
        return 1
    fi

    norm="$(normalize_profile_json "$raw_prof" "$profile_id")"
    if ! validate_normalized_profile "$norm"; then
        return 1
    fi

    if [[ "$(jq -r '.activeProfileId // ""' <<<"$store")" != "$profile_id" ]]; then
        store="$(jq -c --arg id "$profile_id" '.activeProfileId = $id' <<<"$store")"
        write_profiles_store "$store"
    fi

    local config_mode config_server machine_id no_tun
    config_mode="$(jq -r '.configMode' <<<"$norm")"
    config_server="$(jq -r '.configServer' <<<"$norm")"
    machine_id="$(jq -r '.machineId' <<<"$norm")"
    no_tun="$(jq -r '.flags.noTun' <<<"$norm")"

    ensure_private_dir "$RUNTIME_DIR"
    local tmp_env="${MANAGED_ENV_FILE}.tmp.$$"
    local tmp_toml="${MANAGED_TOML_FILE}.tmp.$$"
    local -a core_args=("-r" "$rpc")

    if [[ "$config_mode" == "uri" ]]; then
        (
            umask 077
            printf 'ET_CONFIG_SERVER="%s"\n' "$(escape_env_value "$config_server")" >"$tmp_env"
            : >"$tmp_toml"
        )
        if [[ -n "$machine_id" ]]; then
            if [[ "$machine_id" == -* || "$machine_id" == *[[:space:]]* ]]; then
                rm -f "$tmp_env" "$tmp_toml"
                printf 'Invalid machine ID\n' >&2
                return 1
            fi
            core_args+=("--machine-id" "$machine_id")
        fi
        if [[ "$no_tun" == "true" ]]; then
            core_args+=("--no-tun")
        fi
    else
        (
            umask 077
            : >"$tmp_env"
            render_profile_toml "$norm" >"$tmp_toml"
        )

        local chk_err=""
        if ! chk_err="$(cd "$RUNTIME_DIR" && "$EASYTIER_CORE_BIN" -c "$tmp_toml" --check-config 2>&1)"; then
            rm -f "$tmp_env" "$tmp_toml" "$RUNTIME_DIR/easytier-panic.log" 2>/dev/null || true
            printf 'Config validation failed: %s\n' "$chk_err" >&2
            return 1
        fi
        rm -f "$RUNTIME_DIR/easytier-panic.log" 2>/dev/null || true

        if [[ "$no_tun" == "true" ]]; then
            core_args+=("-c" "$MANAGED_TOML_FILE")
        else
            core_args+=("-c" "$ROOT_RUNTIME_DIR/managed.toml")
        fi
    fi

    mv -f "$tmp_env" "$MANAGED_ENV_FILE"
    mv -f "$tmp_toml" "$MANAGED_TOML_FILE"

    "$SYSTEMCTL_BIN" --user stop "$MANAGED_UNIT" 2>/dev/null || true
    "$SYSTEMCTL_BIN" --user reset-failed "$MANAGED_UNIT" 2>/dev/null || true

    local core_path systemd_run_path systemctl_path
    core_path="$(command -v "$EASYTIER_CORE_BIN")"
    systemd_run_path="$(command -v "$SYSTEMD_RUN_BIN")"
    systemctl_path="$(command -v "$SYSTEMCTL_BIN")"

    if [[ "$no_tun" == "true" ]]; then
        local sys_state
        sys_state="$(service_state "$MANAGED_UNIT" "system")"
        if [[ "$sys_state" == "active" || "$sys_state" == "activating" ]]; then
            run_as_root "$SELF_SCRIPT" _root-managed-apply stop "$systemctl_path" || true
        fi
        "$systemd_run_path" --user \
            --unit="$MANAGED_UNIT" \
            --collect \
            --property=Restart=on-failure \
            --property=RestartSec=3s \
            --property="EnvironmentFile=$MANAGED_ENV_FILE" \
            "$core_path" "${core_args[@]}" >/dev/null
    else
        run_as_root "$SELF_SCRIPT" _root-managed-apply start "$systemctl_path" "$systemd_run_path" "$MANAGED_ENV_FILE" "$MANAGED_TOML_FILE" "$core_path" "${core_args[@]}"
    fi
}

stop_managed_profile() {
    if command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1; then
        local u_state s_state systemctl_path
        systemctl_path="$(command -v "$SYSTEMCTL_BIN")"
        u_state="$(service_state "$MANAGED_UNIT" "user")"
        if [[ "$u_state" == "active" || "$u_state" == "activating" || "$u_state" == "failed" ]]; then
            "$systemctl_path" --user stop "$MANAGED_UNIT" 2>/dev/null || true
            "$systemctl_path" --user reset-failed "$MANAGED_UNIT" 2>/dev/null || true
        fi
        s_state="$(service_state "$MANAGED_UNIT" "system")"
        if [[ "$s_state" == "active" || "$s_state" == "activating" || "$s_state" == "failed" ]]; then
            if "$systemctl_path" --no-ask-password stop "$MANAGED_UNIT" 2>/dev/null; then
                "$systemctl_path" --no-ask-password reset-failed "$MANAGED_UNIT" 2>/dev/null || true
            else
                run_as_root "$SELF_SCRIPT" _root-managed-apply stop "$systemctl_path"
            fi
        fi
    fi
    rm -f "$MANAGED_ENV_FILE" "$MANAGED_TOML_FILE" "$RUNTIME_DIR/easytier-panic.log" 2>/dev/null || true
}

# [RPC Query & Sanitization]
fetch_node_sanitized() {
    local rpc="$1"
    local raw
    if ! raw="$("$EASYTIER_CLI_BIN" -p "$rpc" -o json node)"; then
        return 1
    fi
    printf '%s' "$raw" | jq -ce '{
        peer_id: (.peer_id // ""),
        ipv4_addr: (.ipv4_addr // ""),
        proxy_cidrs: (.proxy_cidrs // []),
        hostname: (.hostname // ""),
        inst_id: (.inst_id // ""),
        listeners: (.listeners // []),
        version: (.version // ""),
        network_name_hint: (((.config // "") | capture("(?m)^\\s*network_name\\s*=\\s*\"(?<n>[^\"]*)\"") | .n) // "")
    }'
}

fetch_subcommand_array() {
    local rpc="$1"
    shift
    local raw
    if ! raw="$("$EASYTIER_CLI_BIN" -p "$rpc" -o json "$@" 2>/dev/null)"; then
        printf '[]'
        return 0
    fi
    printf '%s' "$raw" | jq -c 'if type == "array" then . else [] end' 2>/dev/null || printf '[]'
}

build_status_json() {
    local rpc="$1"
    local unit="$2"
    local scope="$3"

    local cli_available="false"
    if command -v "$EASYTIER_CLI_BIN" >/dev/null 2>&1; then
        cli_available="true"
    fi

    local svc_state svc_active="false"
    svc_state="$(service_state "$unit" "$scope")"
    if [[ "$svc_state" == "active" ]]; then
        svc_active="true"
    fi

    local mgd_info mgd_state mgd_scope mgd_active="false"
    mgd_info="$(managed_unit_info)"
    mgd_state="${mgd_info%%$'\t'*}"
    mgd_scope="${mgd_info#*$'\t'}"
    if [[ "$mgd_state" == "active" ]]; then
        mgd_active="true"
    fi

    local prof_summary
    prof_summary="$(sanitize_profiles_summary "$(read_profiles_store)")"

    if [[ "$cli_available" != "true" ]]; then
        jq -cn \
            --arg svcState "$svc_state" \
            --arg unit "$unit" \
            --arg scope "$scope" \
            --arg rpc "$rpc" \
            --arg mgdState "$mgd_state" \
            --arg mgdScope "$mgd_scope" \
            --argjson svcActive "$svc_active" \
            --argjson mgdActive "$mgd_active" \
            --argjson profSummary "$prof_summary" \
            '{
                ok: true,
                cliAvailable: false,
                serviceActive: $svcActive,
                serviceState: $svcState,
                serviceUnit: $unit,
                serviceScope: $scope,
                managedActive: $mgdActive,
                managedState: $mgdState,
                managedScope: $mgdScope,
                activeProfileId: $profSummary.activeProfileId,
                profileSummaries: $profSummary.profiles,
                rpcPortal: $rpc,
                rpcConnected: false,
                self: null,
                peers: [],
                routes: [],
                connectors: [],
                traffic: { rxBytes: 0, txBytes: 0, forwardedBytes: 0 },
                counts: { total: 0, p2p: 0, relay: 0 },
                error: ""
            }'
        return 0
    fi

    ensure_private_dir "$RUNTIME_DIR"
    local node_json="" node_err="" no_instance="false" tmp_err_file="$RUNTIME_DIR/rpc.err.$$"
    if ! node_json="$(fetch_node_sanitized "$rpc" 2>"$tmp_err_file")"; then
        node_err="$(cat "$tmp_err_file" 2>/dev/null || true)"
        rm -f "$tmp_err_file" 2>/dev/null || true
        if [[ "$node_err" == *"no running instances found"* ]]; then
            no_instance="true"
        fi
        jq -cn \
            --arg svcState "$svc_state" \
            --arg unit "$unit" \
            --arg scope "$scope" \
            --arg rpc "$rpc" \
            --arg mgdState "$mgd_state" \
            --arg mgdScope "$mgd_scope" \
            --argjson svcActive "$svc_active" \
            --argjson mgdActive "$mgd_active" \
            --argjson noInstance "$no_instance" \
            --argjson profSummary "$prof_summary" \
            '{
                ok: true,
                cliAvailable: true,
                serviceActive: $svcActive,
                serviceState: $svcState,
                serviceUnit: $unit,
                serviceScope: $scope,
                managedActive: $mgdActive,
                managedState: $mgdState,
                managedScope: $mgdScope,
                activeProfileId: $profSummary.activeProfileId,
                profileSummaries: $profSummary.profiles,
                rpcPortal: $rpc,
                rpcConnected: false,
                noInstance: $noInstance,
                self: null,
                peers: [],
                routes: [],
                connectors: [],
                traffic: { rxBytes: 0, txBytes: 0, forwardedBytes: 0 },
                counts: { total: 0, p2p: 0, relay: 0 },
                error: ""
            }'
        return 0
    fi
    rm -f "$tmp_err_file" 2>/dev/null || true

    local peers_raw routes_raw stats_raw connectors_raw
    peers_raw="$(fetch_subcommand_array "$rpc" peer)"
    routes_raw="$(fetch_subcommand_array "$rpc" route)"
    stats_raw="$(fetch_subcommand_array "$rpc" stats)"
    connectors_raw="$(fetch_subcommand_array "$rpc" connector list)"

    jq -cn \
        --arg svcState "$svc_state" \
        --arg unit "$unit" \
        --arg scope "$scope" \
        --arg rpc "$rpc" \
        --arg mgdState "$mgd_state" \
        --arg mgdScope "$mgd_scope" \
        --argjson svcActive "$svc_active" \
        --argjson mgdActive "$mgd_active" \
        --argjson profSummary "$prof_summary" \
        --argjson node "$node_json" \
        --argjson peers "$peers_raw" \
        --argjson routes "$routes_raw" \
        --argjson stats "$stats_raw" \
        --argjson connectors "$connectors_raw" \
        '
        def strip_cidr($s):
            ($s // "" | tostring) as $v
            | if $v == "" or $v == "-" then ""
              else ($v | split("/")[0])
              end;

        def parse_lat($s):
            try (($s // "-" | tostring | capture("^(?<n>[0-9]+(\\.[0-9]+)?)") | .n | tonumber))
            catch -1;

        def peer_mode($cost):
            ($cost // "" | tostring | ascii_downcase) as $c
            | if ($c | startswith("p2p")) then "p2p"
              elif ($c | contains("relay")) then "relay"
              else "other"
              end;

        def connector_state($st):
            if ($st | type) == "number" then
                if $st == 0 then "connected"
                elif $st == 2 then "connecting"
                else "disconnected"
                end
            else
                ($st // "" | tostring | ascii_downcase) as $s
                | if ($s | contains("connect")) and ($s | contains("dis") | not) then
                    if ($s | contains("ing")) then "connecting" else "connected" end
                  else "disconnected"
                  end
            end;

        def stat_val($name):
            ([ $stats[] | select(.name == $name) | (.value // 0) ] | first) // 0;

        ([ $peers[] | select((.cost // "") == "Local") ] | first) as $localPeer
        | (([ $stats[] | .labels.network_name // empty | select(length > 0) ] | first) // $node.network_name_hint // "") as $netName
        | [
            $peers[]
            | select((.cost // "") != "Local")
            | {
                id: (.id // "" | tostring),
                hostname: (.hostname // ""),
                ipv4: (if (.ipv4 // "") != "" and (.ipv4 // "") != "-" then (.ipv4 | tostring) else strip_cidr(.cidr) end),
                cidr: (.cidr // "" | tostring),
                cost: (.cost // "" | tostring),
                mode: peer_mode(.cost),
                latencyMs: parse_lat(.lat_ms),
                latencyText: (.lat_ms // "-" | tostring),
                lossText: (.loss_rate // "-" | tostring),
                rxText: (.rx_bytes // "-" | tostring),
                txText: (.tx_bytes // "-" | tostring),
                proto: (.tunnel_proto // "-" | tostring),
                natType: (.nat_type // "Unknown" | tostring),
                version: (.version // "" | tostring)
            }
        ] as $remotePeers
        | ($remotePeers | sort_by((if .mode == "p2p" then 0 elif .mode == "relay" then 1 else 2 end), (if .latencyMs < 0 then 999999 else .latencyMs end), .hostname)) as $sortedPeers
        | [
            $routes[]
            | select(((.next_hop_hostname // "") != "Local") or (((.proxy_cidrs // "") | tostring) != "" and ((.proxy_cidrs // "") | tostring) != "-"))
            | {
                hostname: (.hostname // "" | tostring),
                ipv4: strip_cidr(.ipv4),
                proxyCidrs: (
                    if (.proxy_cidrs | type) == "array" then
                        [ .proxy_cidrs[] | tostring | select(length > 0 and . != "-") ]
                    else
                        [ ((.proxy_cidrs // "") | tostring | split(",")[] | gsub("^\\s+|\\s+$"; "") | select(length > 0 and . != "-")) ]
                    end
                ),
                nextHopHostname: (.next_hop_hostname // "" | tostring),
                nextHopIpv4: (.next_hop_ipv4 // "" | tostring),
                pathLen: (.path_len // 0),
                pathLatency: (.path_latency // 0)
            }
            | select((.proxyCidrs | length) > 0)
        ] as $proxyRoutes
        | [
            $connectors[]
            | (if (.url | type) == "object" then (.url.url // "") else (.url // "" | tostring) end) as $u
            | select(($u | length) > 0)
            | {
                url: $u,
                proto: (($u | split("://")[0]) // ""),
                state: connector_state(.status)
            }
        ] as $normConnectors
        | {
            ok: true,
            cliAvailable: true,
            serviceActive: $svcActive,
            serviceState: $svcState,
            serviceUnit: $unit,
            serviceScope: $scope,
            managedActive: $mgdActive,
            managedState: $mgdState,
            managedScope: $mgdScope,
            activeProfileId: $profSummary.activeProfileId,
            profileSummaries: $profSummary.profiles,
            rpcPortal: $rpc,
            rpcConnected: true,
            self: {
                peerId: ($node.peer_id | tostring),
                hostname: ($node.hostname // ""),
                ipv4: strip_cidr($node.ipv4_addr),
                cidr: ($node.ipv4_addr // ""),
                networkName: $netName,
                natType: (($localPeer.nat_type // "Unknown") | tostring),
                version: ($node.version // ""),
                proxyCidrs: ($node.proxy_cidrs // []),
                listeners: [ ($node.listeners // [])[] | tostring | select((startswith("ring://") | not)) ]
            },
            peers: $sortedPeers,
            routes: $proxyRoutes,
            connectors: $normConnectors,
            traffic: {
                rxBytes: stat_val("traffic_bytes_rx"),
                txBytes: stat_val("traffic_bytes_tx"),
                forwardedBytes: stat_val("traffic_bytes_forwarded")
            },
            counts: {
                total: ($sortedPeers | length),
                p2p: ([ $sortedPeers[] | select(.mode == "p2p") ] | length),
                relay: ([ $sortedPeers[] | select(.mode == "relay") ] | length)
            },
            error: ""
        }'
}

wait_for_rpc() {
    local rpc="$1"
    local expect_up="$2"
    local attempts="${3:-10}"
    local i
    for ((i = 0; i < attempts; i++)); do
        if "$EASYTIER_CLI_BIN" -p "$rpc" -o json node >/dev/null 2>&1; then
            if [[ "$expect_up" == "true" ]]; then
                return 0
            fi
        else
            if [[ "$expect_up" == "false" ]]; then
                return 0
            fi
        fi
        sleep 0.25
    done
    return 0
}

# [Command Dispatch]
cmd="${1:-status}"

case "$cmd" in
    _root-managed-apply)
        if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
            printf 'Root privileges required\n' >&2
            exit 1
        fi
        sub_op="${2:-}"
        systemctl_path="${3:-systemctl}"
        if [[ "$sub_op" == "stop" ]]; then
            "$systemctl_path" stop "$MANAGED_UNIT" 2>/dev/null || true
            "$systemctl_path" reset-failed "$MANAGED_UNIT" 2>/dev/null || true
            rm -rf "$ROOT_RUNTIME_DIR" 2>/dev/null || true
            exit 0
        elif [[ "$sub_op" == "start" ]]; then
            systemd_run_path="${4:-systemd-run}"
            env_file="${5:-}"
            toml_file="${6:-}"
            core_path="${7:-}"
            shift 7
            "$systemctl_path" stop "$MANAGED_UNIT" 2>/dev/null || true
            "$systemctl_path" reset-failed "$MANAGED_UNIT" 2>/dev/null || true
            mkdir -p "$ROOT_RUNTIME_DIR"
            chmod 700 "$ROOT_RUNTIME_DIR"
            install -m 600 "$env_file" "$ROOT_RUNTIME_DIR/managed.env"
            install -m 600 "$toml_file" "$ROOT_RUNTIME_DIR/managed.toml"
            "$systemd_run_path" \
                --unit="$MANAGED_UNIT" \
                --collect \
                --property=Restart=on-failure \
                --property=RestartSec=3s \
                --property="CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE" \
                --property="AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE" \
                --property="EnvironmentFile=$ROOT_RUNTIME_DIR/managed.env" \
                "$core_path" "$@" >/dev/null
            exit 0
        else
            printf 'Invalid internal sub-operation\n' >&2
            exit 1
        fi
        ;;

    status)
        rpc="${2:-$DEFAULT_RPC}"
        raw_unit="${3:-$DEFAULT_UNIT}"
        scope="${4:-$DEFAULT_SCOPE}"

        if ! validate_rpc "$rpc"; then
            json_error "Invalid RPC portal: $rpc"
            exit 1
        fi
        if ! unit="$(normalize_unit "$raw_unit")"; then
            json_error "Invalid systemd unit: $raw_unit"
            exit 1
        fi
        if ! validate_scope "$scope"; then
            json_error "Invalid systemd scope: $scope"
            exit 1
        fi

        build_status_json "$rpc" "$unit" "$scope"
        ;;

    start|stop|restart|toggle)
        raw_unit="${2:-$DEFAULT_UNIT}"
        scope="${3:-$DEFAULT_SCOPE}"
        rpc="${4:-$DEFAULT_RPC}"

        if ! unit="$(normalize_unit "$raw_unit")"; then
            json_error "Invalid systemd unit: $raw_unit"
            exit 1
        fi
        if ! validate_scope "$scope"; then
            json_error "Invalid systemd scope: $scope"
            exit 1
        fi
        if ! validate_rpc "$rpc"; then
            json_error "Invalid RPC portal: $rpc"
            exit 1
        fi

        target_action="$cmd"
        if [[ "$cmd" == "toggle" ]]; then
            cur_state="$(service_state "$unit" "$scope")"
            if [[ "$cur_state" == "active" || "$cur_state" == "activating" ]]; then
                target_action="stop"
            else
                target_action="start"
            fi
        fi

        err_output=""
        if ! err_output="$(run_service_action "$target_action" "$unit" "$scope" 2>&1)"; then
            clean_err="$(printf '%s' "$err_output" | tr '\r\n' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
            json_error "${clean_err:-Failed to $target_action $unit}"
            exit 1
        fi

        if command -v "$EASYTIER_CLI_BIN" >/dev/null 2>&1; then
            if [[ "$target_action" == "stop" ]]; then
                wait_for_rpc "$rpc" "false" 8
            else
                wait_for_rpc "$rpc" "true" 12
            fi
        fi

        build_status_json "$rpc" "$unit" "$scope" | jq -c --arg action "$target_action" '. + {action: $action}'
        ;;

    managed-start|managed-stop|managed-restart|managed-toggle)
        profile_id="${2:-}"
        rpc="${3:-$DEFAULT_RPC}"
        raw_unit="${4:-$DEFAULT_UNIT}"
        scope="${5:-$DEFAULT_SCOPE}"

        if [[ -n "$profile_id" && "$profile_id" == *[!a-zA-Z0-9_-]* ]]; then
            json_error "Invalid profile ID"
            exit 1
        fi
        if ! validate_rpc "$rpc"; then
            json_error "Invalid RPC portal: $rpc"
            exit 1
        fi
        if ! unit="$(normalize_unit "$raw_unit")"; then
            json_error "Invalid systemd unit: $raw_unit"
            exit 1
        fi
        if ! validate_scope "$scope"; then
            json_error "Invalid systemd scope: $scope"
            exit 1
        fi

        target_action="start"
        if [[ "$cmd" == "managed-stop" ]]; then
            target_action="stop"
        elif [[ "$cmd" == "managed-restart" ]]; then
            target_action="restart"
        elif [[ "$cmd" == "managed-toggle" ]]; then
            mgd_info="$(managed_unit_info)"
            mgd_state="${mgd_info%%$'\t'*}"
            if [[ "$mgd_state" == "active" || "$mgd_state" == "activating" ]]; then
                target_action="stop"
            else
                target_action="start"
            fi
        fi

        err_output=""
        if [[ "$target_action" == "stop" ]]; then
            if ! err_output="$(stop_managed_profile 2>&1)"; then
                clean_err="$(printf '%s' "$err_output" | tr '\r\n' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
                json_error "${clean_err:-Failed to stop managed EasyTier}"
                exit 1
            fi
            if command -v "$EASYTIER_CLI_BIN" >/dev/null 2>&1; then
                wait_for_rpc "$rpc" "false" 8
            fi
        else
            if ! err_output="$(start_managed_profile "$profile_id" "$rpc" 2>&1)"; then
                clean_err="$(printf '%s' "$err_output" | tr '\r\n' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
                json_error "${clean_err:-Failed to start managed profile}"
                exit 1
            fi
            if command -v "$EASYTIER_CLI_BIN" >/dev/null 2>&1; then
                wait_for_rpc "$rpc" "true" 14
            fi
        fi

        build_status_json "$rpc" "$unit" "$scope" | jq -c --arg action "$target_action" '. + {action: $action}'
        ;;

    profile-list)
        store="$(read_profiles_store)"
        jq -cn --argjson store "$store" '{
            ok: true,
            activeProfileId: $store.activeProfileId,
            profiles: $store.profiles
        }'
        ;;

    profile-save)
        raw_profile="${2:-}"
        if [[ -z "$raw_profile" ]]; then
            json_error "Missing profile JSON payload"
            exit 1
        fi

        gen_id="prof-$(date +%s)-$RANDOM"
        normalized=""
        if ! normalized="$(normalize_profile_json "$raw_profile" "$gen_id" 2>/dev/null)"; then
            json_error "Malformed profile JSON"
            exit 1
        fi

        val_err=""
        if ! val_err="$(validate_normalized_profile "$normalized" 2>&1)"; then
            clean_val="$(printf '%s' "$val_err" | tr '\r\n' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
            json_error "${clean_val:-Invalid profile configuration}"
            exit 1
        fi

        prof_id="$(jq -r '.id' <<<"$normalized")"
        store="$(read_profiles_store)"
        updated_store="$(jq -c --argjson prof "$normalized" '
            (if any(.profiles[]; .id == $prof.id) then
                .profiles |= map(if .id == $prof.id then $prof else . end)
             else
                .profiles += [$prof]
             end)
            | if (.activeProfileId // "") == "" then .activeProfileId = $prof.id else . end
        ' <<<"$store")"
        write_profiles_store "$updated_store"

        jq -cn --arg id "$prof_id" --argjson store "$updated_store" '{
            ok: true,
            id: $id,
            activeProfileId: $store.activeProfileId,
            profiles: $store.profiles
        }'
        ;;

    profile-delete)
        del_id="${2:-}"
        if [[ -z "$del_id" || "$del_id" == *[!a-zA-Z0-9_-]* ]]; then
            json_error "Invalid profile ID"
            exit 1
        fi
        store="$(read_profiles_store)"
        updated_store="$(jq -c --arg id "$del_id" '
            .profiles |= map(select(.id != $id))
            | if .activeProfileId == $id then
                .activeProfileId = (.profiles[0].id // "")
              else . end
        ' <<<"$store")"
        write_profiles_store "$updated_store"
        jq -cn --argjson store "$updated_store" '{
            ok: true,
            activeProfileId: $store.activeProfileId,
            profiles: $store.profiles
        }'
        ;;

    profile-select)
        sel_id="${2:-}"
        if [[ -z "$sel_id" || "$sel_id" == *[!a-zA-Z0-9_-]* ]]; then
            json_error "Invalid profile ID"
            exit 1
        fi
        store="$(read_profiles_store)"
        if [[ "$(jq -r --arg id "$sel_id" 'any(.profiles[]; .id == $id)' <<<"$store")" != "true" ]]; then
            json_error "Profile not found: $sel_id"
            exit 1
        fi
        updated_store="$(jq -c --arg id "$sel_id" '.activeProfileId = $id' <<<"$store")"
        write_profiles_store "$updated_store"
        jq -cn --argjson store "$updated_store" '{
            ok: true,
            activeProfileId: $store.activeProfileId,
            profiles: $store.profiles
        }'
        ;;

    connector-add|connector-remove)
        conn_url="${2:-}"
        rpc="${3:-$DEFAULT_RPC}"
        raw_unit="${4:-$DEFAULT_UNIT}"
        scope="${5:-$DEFAULT_SCOPE}"

        if ! validate_connector_url "$conn_url"; then
            json_error "Invalid connector URL: $conn_url"
            exit 1
        fi
        if ! validate_rpc "$rpc"; then
            json_error "Invalid RPC portal: $rpc"
            exit 1
        fi
        if ! unit="$(normalize_unit "$raw_unit")"; then
            json_error "Invalid systemd unit: $raw_unit"
            exit 1
        fi
        if ! validate_scope "$scope"; then
            json_error "Invalid systemd scope: $scope"
            exit 1
        fi

        sub_action="add"
        if [[ "$cmd" == "connector-remove" ]]; then
            sub_action="remove"
        fi

        err_output=""
        if ! err_output="$("$EASYTIER_CLI_BIN" -p "$rpc" connector "$sub_action" "$conn_url" 2>&1)"; then
            clean_err="$(printf '%s' "$err_output" | tr '\r\n' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
            json_error "${clean_err:-Failed to $sub_action connector}"
            exit 1
        fi

        build_status_json "$rpc" "$unit" "$scope"
        ;;

    *)
        json_error "Unsupported command: $cmd"
        exit 1
        ;;
esac
